{
  "name": "skill-evaluation",
  "version": "0.0.1",
  "description": "",
  "license": "UNLICENSED",
  "imports": {
    "#now:*": "./@types/servicenow/fluent/*/index.js"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "now-sdk build -a pdi-kl-o2",
    "deploy": "now-sdk install -a pdi-kl-o2",
    "transform": "now-sdk transform -a pdi-kl-o2",
    "types": "now-sdk dependencies -a pdi-kl-o2",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "node --test test/**/*.test.ts",
    "test:atf": "now-sdk cicd testsuite run -a pdi-kl-o2 --test-suite-name \"Skill Evaluation\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test e2e/specs/01-smoke.spec.ts",
    "test:e2e:member": "playwright test e2e/specs/02-member-journey.spec.ts",
    "test:e2e:pm": "playwright test e2e/specs/03-pm-gate.spec.ts",
    "test:e2e:coe": "playwright test e2e/specs/04-coe-gate.spec.ts",
    "test:e2e:rbac": "playwright test e2e/specs/05-navigator-rbac.spec.ts",
    "typecheck": "tsc --noEmit -p src/server/tsconfig.json",
    "ci:build": "now-sdk build --frozenKeys",
    "ci:install": "now-sdk install",
    "ci:testsuite": "now-sdk cicd testsuite run --test-suite-name \"Skill Evaluation\"",
    "ci:publish": "now-sdk cicd publish",
    "ci:promote": "now-sdk cicd install",
    "ci:rollback": "now-sdk cicd rollback"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.83.0",
    "@playwright/test": "1.61.1",
    "@servicenow/glide": "27.0.5",
    "@servicenow/sdk": "4.12.2",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "5.5.4"
  },
  "engines": {
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "packageManager": "pnpm@11.21.0"
}
